# 공공데이터포털에서 발급받은 서비스 키를 .env.local 에 복사해서 채워 넣으세요.
# .env.local 은 .gitignore 에 포함되어 있어 커밋되지 않습니다.
# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 .gitignore 에 있어 커밋되지 않음)
# 키가 비어 있으면 관광정보/날씨는 자동으로 목업 데이터로 동작합니다.

# Spring 백엔드 주소 (backend/ 를 실행한 뒤). 설정하면 회원·로그인·보따리(찜)가 서버 DB에 저장되고,
# TourAPI 키가 없을 때 여행지 검색/상세도 백엔드 DB 데이터를 사용한다. 비워 두면 브라우저 목업으로 동작.
VITE_API_BASE_URL=http://localhost:8080

# 공공데이터포털 일반 인증키. Decoding 키 권장 (Encoding 키를 넣어도 자동 변환됨)
# 아래 두 API를 각각 활용신청해야 같은 키로 호출 가능:
#   - 한국관광공사_국문 관광정보 서비스_GW  https://www.data.go.kr/data/15101578/openapi.do
#   - 기상청_단기예보 조회서비스            https://www.data.go.kr/data/15084084/openapi.do
VITE_API_SERVICE_KEY=

# true 면 키·백엔드가 있어도 여행지 데이터는 전부 목업 사용
VITE_USE_MOCK=false

# Weather stays live independently of the favorites mock mode.
VITE_WEATHER_USE_MOCK=false

# 카카오맵 JavaScript 키 (https://developers.kakao.com)
# 앱 설정 > 플랫폼 > Web 에 http://localhost:5173 을 등록해야 지도가 뜬다
VITE_KAKAO_MAP_KEY=

# 카카오모빌리티 길찾기 REST 키 — 서버(/api/kakao-route)에서만 읽는다. KAKAO_REST_API_KEY 이름도 인식
KAKAO_REST_API_KEY=

# OpenAI (AI 코스 추천). VITE_ 접두사가 없어서 브라우저로 안 나가고 서버(/api/ai-course)에서만 쓰인다
OPENAI_API_KEY=
# 선택: 기본값 gpt-4o-mini
OPENAI_MODEL=

# OpenWeatherMap 키 (AI 코스 추천의 현재 날씨). 서버(/api/weather)에서만 읽는다. VITE_WEATHER_KEY 이름도 인식한다
WEATHER_KEY=
