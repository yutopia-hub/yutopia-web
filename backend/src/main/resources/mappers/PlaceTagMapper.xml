<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yutopia.model.dao.PlaceTagDao">
    <resultMap id="tagResultMap" type="com.yutopia.model.dto.PlaceTag">
        <id property="placeId" column="place_id"/>
        <id property="tag" column="tag"/>
    </resultMap>

    <insert id="insert" parameterType="com.yutopia.model.dto.PlaceTag">
        INSERT INTO place_tags (place_id, tag) VALUES (#{placeId}, #{tag})
    </insert>

    <select id="findByPlaceId" resultMap="tagResultMap">
        SELECT place_id, tag FROM place_tags WHERE place_id = #{placeId} ORDER BY tag
    </select>

    <delete id="delete">
        DELETE FROM place_tags WHERE place_id = #{placeId} AND tag = #{tag}
    </delete>
</mapper>
