# Copy to application-test-local.properties (ignored by Git) and use your test DB credentials.
# The database name must be yutopia_test. Tests refuse any other catalog.
spring.datasource.url=jdbc:mysql://localhost:3306/yutopia_test?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=${YUTOPIA_TEST_DB_USERNAME:root}
spring.datasource.password=${YUTOPIA_TEST_DB_PASSWORD:}
