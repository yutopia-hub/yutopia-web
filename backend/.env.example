TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=YOUR_DATA_GO_KR_SERVICE_KEY
TOUR_API_USE_MOCK=false

# Backend imports .env as a Java properties file (KEY=value, no quotes/export).
# Shell/IDE environment variables take precedence over file values.
# In this imported file use the Spring property name (not a shell variable).
spring.profiles.active=ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TMAP pedestrian route API app key; never use a VITE_ prefix.
TMAP_API_KEY=

# Kakao Local API REST key (not the JavaScript map key).
KAKAO_REST_API_KEY=
